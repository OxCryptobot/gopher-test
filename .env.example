# GOPHER python hole. Copy to .env (gitignored). Never commit secrets.
# Live bot webhook URL. Leave empty to park llm.
GOPHER_LLM_HOOK=
# Sender key from the bot routine panel. Optional; sent when set.
GOPHER_LLM_KEY=
# Public base URL of this process. Used to build /api/brain/reply.
GOPHER_PUBLIC_URL=
# Optional override of the reply POST URL (defaults to PUBLIC_URL + /api/brain/reply).
# GOPHER_REPLY_URL=
# Public Pages pointer is hole.json top-level "brain" (https URL of this process). Empty = matcher-only. Never put GOPHER_LLM_KEY in hole.json or the client.

# Telegram test channel. Empty = parked. Never invent a bot username.
TELEGRAM_BOT_TOKEN=
# Optional webhook secret (X-Telegram-Bot-Api-Secret-Token).
# TELEGRAM_WEBHOOK_SECRET=
# Dev-only Telegram API base (default https://api.telegram.org).
# GOPHER_TELEGRAM_API=

# Resend waitlist mail (free tier). Empty = parked. Needs a from address you own.
RESEND_API_KEY=
GOPHER_MAIL_FROM=
# Legacy waitlist hook still works if set:
# GOPHER_MAIL_HOOK=
