# GOPHER python hole. Copy to .env (gitignored). Never commit secrets.
# Comments only for values you do not have — leave empty to park that plugin.

# --- Process bind ---
# Host bind (containers / free hosts: 0.0.0.0).
# GOPHER_HOST=0.0.0.0
# Local default 7070. Free hosts usually inject PORT; server reads GOPHER_PORT then PORT.
# GOPHER_PORT=7070
# PORT=8080

# --- Live bot webhook (llm). Leave empty to park llm. ---
GOPHER_LLM_HOOK=
# Sender key from the bot routine panel. Optional; sent when set. Never put in hole.json.
GOPHER_LLM_KEY=
# Public base URL of this process (https origin, no path). Used to build /api/brain/reply.
GOPHER_PUBLIC_URL=
# Optional override of the reply POST URL (defaults to PUBLIC_URL + /api/brain/reply).
# GOPHER_REPLY_URL=
# Public Pages pointer is hole.json top-level "brain" (https URL of this process).
# Empty brain = matcher-only. Never put GOPHER_LLM_KEY in hole.json or the client.

# --- Telegram test channel. Empty = parked. Never invent a bot username. ---
TELEGRAM_BOT_TOKEN=
# Optional webhook secret (X-Telegram-Bot-Api-Secret-Token). Must match setWebhook secret_token.
# TELEGRAM_WEBHOOK_SECRET=
# Dev-only Telegram API base (default https://api.telegram.org).
# GOPHER_TELEGRAM_API=

# --- Resend waitlist mail (free tier). Empty = parked. Needs a from address you own. ---
RESEND_API_KEY=
GOPHER_MAIL_FROM=
# Alias accepted by server if GOPHER_MAIL_FROM unset:
# RESEND_FROM=
# Legacy waitlist hook still works if set:
# GOPHER_MAIL_HOOK=
# Optional SendGrid key also marks mail ready (hook path still preferred for custom):
# SENDGRID_API_KEY=

# --- Twilio (optional forever; never required). Empty = parked / HTTP 503. ---
# Do not invent a number. Prefer Telegram + Resend + Ask first.
# TWILIO_NUMBER=
# TWILIO_AUTH_TOKEN=
# Dev-only signature skip (never on a public hole):
# GOPHER_TWILIO_SKIP_SIG=

# Dev-only Resend API base (default https://api.resend.com). Tests use a local capture.
# GOPHER_RESEND_API=
# RESEND_FROM= is an alias for GOPHER_MAIL_FROM

